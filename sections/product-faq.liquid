{{ 'main-team-member.css' | asset_url | stylesheet_tag }}
{{ 'component-rte.css' | asset_url | stylesheet_tag }}
{{ 'section-collapsible-content.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collapsible-content.js' | asset_url }}" defer="defer"></script>

{%- assign faqs = product.metafields.custom.faqs.value -%}
<div class="faq-wrapper container color-{{ section.settings.color_scheme }}">
  {% if faqs.size > 0 %}
    <div class="main-team-member__faqs">
      {% render 'section-header',
        
      section_heading: section.settings.faq_heading,
        section_heading_size: 'h2'
      %}

      <div class="collapsible-content__items">
        {% for faq in faqs %}
          <div class="collapsible-content__item{% if forloop.first %} active{% endif %}">
            <button
              class="collapsible-content__toggle focus-inset button--unstyled"
              aria-label="{{ faq.question.value | escape }}"
            >
              <div class="collapsible-content__toggle-group">
                {% if faq.question.value != blank %}
                  <h4 class="collapsible-content__question h4 font-weight-medium">
                    {{ faq.question.value }}
                  </h4>
                {% endif %}
              </div>
              <div class="collapsible-content__icon">
                {% render 'icon-minus' %}
                {% render 'icon-plus' %}
              </div>
            </button>

            {% if faq.answer.value != blank %}
              <div class="collapsible-content__answer" {% if forloop.first %}style="display: block;"{% endif %}>
                <div class="collapsible-content__answer-inner richtext__content">
                  {{ faq.answer | metafield_tag }}
                </div>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
  </div>
{% schema %}
{
  "name": "Product FAQ",
  "class": "product-faq-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h3", "label": "Medium" },
        { "value": "h2", "label": "Large" },
        { "value": "h1", "label": "Extra Large" }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "text",
      "id": "faq_heading",
      "default": "Frequently asked questions",
      "label": "FAQ heading"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        { "value": "no-indent", "label": "t:sections.all.section-margin.options__1.label" },
        { "value": "xs", "label": "t:sections.all.section-margin.options__2.label" },
        { "value": "s", "label": "t:sections.all.section-margin.options__3.label" },
        { "value": "m", "label": "t:sections.all.section-margin.options__4.label" },
        { "value": "l", "label": "t:sections.all.section-margin.options__5.label" },
        { "value": "xl", "label": "t:sections.all.section-margin.options__6.label" }
      ],
      "default": "xl",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        { "value": "no-indent", "label": "t:sections.all.section-margin.options__1.label" },
        { "value": "xs", "label": "t:sections.all.section-margin.options__2.label" },
        { "value": "s", "label": "t:sections.all.section-margin.options__3.label" },
        { "value": "m", "label": "t:sections.all.section-margin.options__4.label" },
        { "value": "l", "label": "t:sections.all.section-margin.options__5.label" },
        { "value": "xl", "label": "t:sections.all.section-margin.options__6.label" }
      ],
      "default": "xl",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ],
  "presets": [
		{
			"name": "Product-faq"
		}
	]
}
{% endschema %}

