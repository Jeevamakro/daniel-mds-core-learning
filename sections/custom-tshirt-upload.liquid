{{ 'custom-tshirt-upload.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-tshirt-upload.js' | asset_url }}" defer="defer"></script>

{%- assign product_form_id = 'tshirt-form-' | append: section.id -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}

{%- style -%}
  {% render 'section-margin' %}
  {% render 'section-padding' %}

  #section-{{ section.id }} .tshirt-upload__design-overlay {
    top: {{ section.settings.design_area_top }}%;
    left: {{ section.settings.design_area_left }}%;
    width: {{ section.settings.design_area_width }}%;
    height: {{ section.settings.design_area_height }}%;
  }
{%- endstyle -%}

<section id="section-{{ section.id }}" class="color-{{ section.settings.color_scheme }}">
  <tshirt-upload
    class="tshirt-upload page-width"
    data-api-key="{{ section.settings.imgbb_api_key | escape }}"
    data-max-file-size="{{ section.settings.max_file_size_mb }}"
  >

    <div class="tshirt-upload__layout">

      {%- comment -%} ── LEFT: Mockup & live preview ── {%- endcomment -%}
      <div class="tshirt-upload__preview-panel">
        <div class="tshirt-upload__mockup">

          {%- if product.featured_image != blank -%}
            {%- assign mockup_height = product.featured_image.height | times: 600 | divided_by: product.featured_image.width -%}
            <img
              src="{{ product.featured_image | image_url: width: 600 }}"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              class="tshirt-upload__mockup-image"
              width="600"
              height="{{ mockup_height }}"
              loading="eager"
            >
          {%- else -%}
            <div class="tshirt-upload__mockup-placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'tshirt-upload__mockup-svg' }}
              <p class="tshirt-upload__mockup-placeholder-text">
                Add a product image to enable the live design preview.
              </p>
            </div>
          {%- endif -%}

          {%- comment -%}
            Design overlay — position is set by the <style> block above so we
            avoid inline style attributes per project coding standards.
          {%- endcomment -%}
          <div class="tshirt-upload__design-overlay">
            <img
              class="tshirt-upload__design-image"
              alt="Your custom design preview"
              width="600"
              height="600"
              hidden
            >
            <div class="tshirt-upload__design-hint">
              <span>Your design<br>appears here</span>
            </div>
          </div>

        </div>
        <p class="tshirt-upload__preview-disclaimer">
          Preview is for illustration only. Final print position may vary slightly.
        </p>
      </div>

      {%- comment -%} ── RIGHT: Product info, variants, upload form ── {%- endcomment -%}
      <div class="tshirt-upload__form-panel">

        {%- if section.settings.heading != blank -%}
          <h1 class="tshirt-upload__heading h2">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="tshirt-upload__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}

        {%- comment -%} Price {%- endcomment -%}
        <div class="tshirt-upload__price">
          {%- render 'price', product: product, use_variant: true, show_badges: false -%}
        </div>

        {%- comment -%} Variant option pickers (Size, Colour, etc.) {%- endcomment -%}
        {%- unless product.has_only_default_variant -%}
          <div class="tshirt-upload__variants">
            {%- for option in product.options_with_values -%}
              <div class="tshirt-upload__option" data-option-index="{{ forloop.index0 }}">
                <p class="tshirt-upload__option-label">
                  {{ option.name }}:
                  <strong class="tshirt-upload__option-selected">{{ option.selected_value }}</strong>
                </p>
                <div class="tshirt-upload__option-values" role="radiogroup" aria-label="{{ option.name }}">
                  {%- for value in option.values -%}
                    {%- assign input_id = 'tshirt-opt-' | append: section.id | append: '-' | append: forloop.parentloop.index | append: '-' | append: forloop.index -%}
                    <input
                      type="radio"
                      id="{{ input_id }}"
                      name="tshirt-option-{{ section.id }}-{{ forloop.parentloop.index }}"
                      value="{{ value | escape }}"
                      class="tshirt-upload__option-input"
                      form="{{ product_form_id }}"
                      data-option-index="{{ forloop.parentloop.index0 }}"
                      {%- if option.selected_value == value %} checked{%- endif -%}
                    >
                    <label for="{{ input_id }}" class="tshirt-upload__option-btn">{{ value }}</label>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        {%- comment -%} Variant data consumed by JS for variant-id sync {%- endcomment -%}
        <script type="application/json" class="tshirt-upload__variants-data">
          {{ product.variants | json }}
        </script>

        {%- comment -%} ── Upload area ── {%- endcomment -%}
        <div class="tshirt-upload__upload-section">
          <p class="tshirt-upload__upload-label">Upload Your Design</p>

          <div class="tshirt-upload__dropzone" role="presentation">
            <input
              type="file" id="tshirt-file-{{ section.id }}" class="tshirt-upload__file-input" accept="image/jpeg,image/png,image/webp,image/svg+xml" aria-describedby="tshirt-hint-{{ section.id }}"
            >
            <label for="tshirt-file-{{ section.id }}" class="tshirt-upload__dropzone-inner">
              <svg class="tshirt-upload__upload-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/>
                <line x1="12" y1="3" x2="12" y2="15"/>
              </svg>
              <span class="tshirt-upload__dropzone-text">
                <strong>Click to upload</strong> or drag and drop
              </span>
              <span class="tshirt-upload__dropzone-hint" id="tshirt-hint-{{ section.id }}">
                PNG, JPG, WebP, SVG — max {{ section.settings.max_file_size_mb }}MB
              </span>
            </label>
          </div>

          {%- comment -%} Shown after a file is selected {%- endcomment -%}
          <div class="tshirt-upload__file-info" hidden>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
            </svg>
            <span class="tshirt-upload__file-name"></span>
            <button type="button" class="tshirt-upload__file-remove" aria-label="Remove uploaded design">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" focusable="false">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          </div>

          {%- comment -%} Upload / validation status feedback {%- endcomment -%}
          <div class="tshirt-upload__status" role="status" aria-live="polite" hidden>
            <span class="tshirt-upload__status-text"></span>
          </div>
        </div>

        {%- comment -%} ── Cart form ── {%- endcomment -%}
        {%- form 'product', product, id: product_form_id, class: 'tshirt-upload__cart-form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" class="tshirt-upload__variant-input">

          {%- comment -%}
            Line item properties sent with the order.
            The merchant will see "Custom Design" in the order line items.
            If imgbb API key is configured, the value will be a clickable URL.
            Otherwise it will be a compressed base64 data URL (low-res thumbnail).
          {%- endcomment -%}
          <input type="hidden" name="properties[Custom Design]" class="tshirt-upload__design-url-input" value="">
          <input type="hidden" name="properties[Design File]" class="tshirt-upload__design-name-input" value="">

          <div class="tshirt-upload__cart-actions">
            <button
              type="submit"
              class="tshirt-upload__add-btn button button--primary button--full-width"
              disabled
            >
              <span class="tshirt-upload__btn-idle">
                {{- 'products.product.add_to_cart' | t -}}
              </span>
              <span class="tshirt-upload__btn-loading" hidden>
                <svg class="tshirt-upload__spinner" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                  <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
                </svg>
                Saving your design…
              </span>
            </button>
          </div>
        {%- endform -%}

        {%- if section.settings.upload_note != blank -%}
          <p class="tshirt-upload__note">{{ section.settings.upload_note }}</p>
        {%- endif -%}

      </div>
    </div>

  </tshirt-upload>
</section>

{% schema %}
{
  "name": "Custom T-Shirt Upload",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Design Your Own T-Shirt",
      "info": "Main heading shown above the upload form."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Upload your artwork and see how it looks on the shirt before ordering.",
      "info": "Short description shown below the heading."
    },
    {
      "type": "header",
      "content": "Design Overlay Area",
      "info": "The mockup image is pulled automatically from the product's images. Upload your T-shirt photo directly on the product in Shopify admin."
    },
    {
      "type": "range",
      "id": "design_area_top",
      "label": "Print area — top offset",
      "min": 5,
      "max": 75,
      "step": 1,
      "unit": "%",
      "default": 22,
      "info": "How far from the top of the mockup the print area begins. Adjust until the overlay sits on the chest area of your shirt photo."
    },
    {
      "type": "range",
      "id": "design_area_left",
      "label": "Print area — left offset",
      "min": 5,
      "max": 75,
      "step": 1,
      "unit": "%",
      "default": 25,
      "info": "How far from the left edge the print area begins."
    },
    {
      "type": "range",
      "id": "design_area_width",
      "label": "Print area — width",
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 50,
      "info": "Width of the print area as a percentage of the mockup image width."
    },
    {
      "type": "range",
      "id": "design_area_height",
      "label": "Print area — height",
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 40,
      "info": "Height of the print area as a percentage of the mockup image height."
    },
    {
      "type": "header",
      "content": "Upload Settings"
    },
    {
      "type": "text",
      "id": "imgbb_api_key",
      "label": "imgbb API key",
      "info": "Optional but strongly recommended. Get a free key at imgbb.com → API. With a key, the customer's full-resolution design is hosted and a URL is attached to the order — click it to view the design. Without a key, only a small compressed thumbnail (300 px) is stored in the order as a data string."
    },
    {
      "type": "range",
      "id": "max_file_size_mb",
      "label": "Maximum upload size",
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "MB",
      "default": 10,
      "info": "Maximum file size a customer can upload."
    },
    {
      "type": "textarea",
      "id": "upload_note",
      "label": "Note below Add-to-Cart button",
      "default": "Accepted formats: PNG, JPG, WebP, SVG. We print your design exactly as uploaded — use high-resolution files for the best result.",
      "info": "Visible to customers. Use it to set expectations about file quality and accepted formats."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "background-1"
    }
  ],
  "presets": [
    {
      "name": "Custom T-Shirt Upload"
    }
  ]
}
{% endschema %}
