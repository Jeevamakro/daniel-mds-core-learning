{%- comment -%}
  Before / After section (product-wise, driven by product metafields).

  Images come from two product metafields (type: File -> image).
  Defaults expect:
    custom.before_image
    custom.after_image
  You can point them at any namespace/key in the section settings.

  Add this to a Product template in the theme editor:
  Online Store > Themes > Customize > (Product template) > Add section > "Before / After"
{%- endcomment -%}

{%- liquid
  assign before_ns  = section.settings.before_namespace | default: 'custom'
  assign before_key = section.settings.before_key        | default: 'before_image'
  assign after_ns   = section.settings.after_namespace   | default: 'custom'
  assign after_key  = section.settings.after_key         | default: 'after_image'

  assign before_image = product.metafields[before_ns][before_key].value
  assign after_image  = product.metafields[after_ns][after_key].value

  assign before_field = before_ns | append: '.' | append: before_key
  assign after_field  = after_ns | append: '.' | append: after_key

  assign has_both = false
  if before_image and after_image
    assign has_both = true
  endif

  case section.settings.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'landscape'
      assign ratio = '16 / 9'
    when 'portrait'
      assign ratio = '3 / 4'
    else
      assign ratio = 'auto'
  endcase
-%}

{{ 'section-product-before-after.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .ba {
    --ba-max-width: {{ section.settings.max_width }}px;
    --ba-padding-top: {{ section.settings.padding_top }}px;
    --ba-padding-bottom: {{ section.settings.padding_bottom }}px;
    --ba-radius: {{ section.settings.corner_radius }}px;
    --ba-ratio: {{ ratio }};
    --ba-pos: {{ section.settings.start_position }}%;
    --ba-divider: {{ section.settings.divider_color }};
    --ba-label-bg: {{ section.settings.label_bg }};
    --ba-label-text: {{ section.settings.label_text }};
  }
{%- endstyle -%}

<div class="ba">
  {%- if section.settings.heading != blank -%}
    <h2 class="ba__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- if has_both -%}
    <div class="ba__frame" data-ba="{{ section.id }}">
      <img
        class="ba__img ba__after-layer"
        src="{{ after_image | image_url: width: 1600 }}"
        srcset="{{ after_image | image_url: width: 800 }} 800w, {{ after_image | image_url: width: 1200 }} 1200w, {{ after_image | image_url: width: 1600 }} 1600w"
        sizes="(min-width: {{ section.settings.max_width }}px) {{ section.settings.max_width }}px, 100vw"
        alt="{{ after_image.alt | default: product.title | escape }} — {{ section.settings.after_label }}"
        loading="eager"
        fetchpriority="high"
        width="1600"
        height="1000">

      <img
        class="ba__img ba__before-layer"
        src="{{ before_image | image_url: width: 1600 }}"
        srcset="{{ before_image | image_url: width: 800 }} 800w, {{ before_image | image_url: width: 1200 }} 1200w, {{ before_image | image_url: width: 1600 }} 1600w"
        sizes="(min-width: {{ section.settings.max_width }}px) {{ section.settings.max_width }}px, 100vw"
        alt="{{ before_image.alt | default: product.title | escape }} — {{ section.settings.before_label }}"
        loading="eager"
        width="1600"
        height="1000">

      <span class="ba__label ba__label--before">{{ section.settings.before_label }}</span>
      <span class="ba__label ba__label--after">{{ section.settings.after_label }}</span>

      <div class="ba__divider"></div>
      <div class="ba__handle" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M8 7l-5 5 5 5V7zm8 0v10l5-5-5-5z"/></svg>
      </div>

      <input
        class="ba__range"
        type="range"
        min="0" max="100" step="0.1"
        value="{{ section.settings.start_position }}"
        aria-label="{{ 'sections.product_before_after.comparison_slider_label' | t: before: section.settings.before_label, after: section.settings.after_label }}">
    </div>
  {%- elsif request.design_mode -%}
    <div class="ba__empty">
      {{ 'sections.product_before_after.empty_html' | t: before: before_field, after: after_field }}
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    var frame = document.querySelector('#shopify-section-{{ section.id }} .ba__frame');
    if (!frame) return;
    var range = frame.querySelector('.ba__range');

    function setPos(pct) {
      pct = Math.max(0, Math.min(100, pct));
      frame.style.setProperty('--ba-pos', pct + '%');
    }

    range.addEventListener('input', function () { setPos(parseFloat(range.value)); });

    var dragging = false;
    function fromClientX(clientX) {
      var rect = frame.getBoundingClientRect();
      var pct = ((clientX - rect.left) / rect.width) * 100;
      range.value = pct;
      setPos(pct);
    }
    frame.addEventListener('pointerdown', function (e) {
      dragging = true;
      frame.setPointerCapture(e.pointerId);
      fromClientX(e.clientX);
    });
    frame.addEventListener('pointermove', function (e) {
      if (dragging) fromClientX(e.clientX);
    });
    frame.addEventListener('pointerup', function () { dragging = false; });
    frame.addEventListener('pointercancel', function () { dragging = false; });
  })();
</script>

{% schema %}
{
  "name": "t:sections.product-before-after.name",
  "tag": "section",
  "class": "section-before-after",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.product-before-after.settings.heading.label", "default": "See the difference" },
    {
      "type": "header",
      "content": "t:sections.product-before-after.settings.metafields.content"
    },
    { "type": "text", "id": "before_namespace", "label": "t:sections.product-before-after.settings.before_namespace.label", "default": "custom" },
    { "type": "text", "id": "before_key", "label": "t:sections.product-before-after.settings.before_key.label", "default": "before_image" },
    { "type": "text", "id": "after_namespace", "label": "t:sections.product-before-after.settings.after_namespace.label", "default": "custom" },
    { "type": "text", "id": "after_key", "label": "t:sections.product-before-after.settings.after_key.label", "default": "after_image" },
    {
      "type": "header",
      "content": "t:sections.product-before-after.settings.labels.content"
    },
    { "type": "text", "id": "before_label", "label": "t:sections.product-before-after.settings.before_label.label", "default": "Before" },
    { "type": "text", "id": "after_label", "label": "t:sections.product-before-after.settings.after_label.label", "default": "After" },
    {
      "type": "header",
      "content": "t:sections.product-before-after.settings.layout.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.product-before-after.settings.image_ratio.label",
      "options": [
        { "value": "adapt", "label": "t:sections.product-before-after.settings.image_ratio.options__1.label" },
        { "value": "square", "label": "t:sections.product-before-after.settings.image_ratio.options__2.label" },
        { "value": "landscape", "label": "t:sections.product-before-after.settings.image_ratio.options__3.label" },
        { "value": "portrait", "label": "t:sections.product-before-after.settings.image_ratio.options__4.label" }
      ],
      "default": "landscape"
    },
    { "type": "range", "id": "start_position", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "t:sections.product-before-after.settings.start_position.label", "default": 50 },
    { "type": "range", "id": "max_width", "min": 400, "max": 1600, "step": 20, "unit": "px", "label": "t:sections.product-before-after.settings.max_width.label", "default": 1000 },
    { "type": "range", "id": "corner_radius", "min": 0, "max": 40, "step": 1, "unit": "px", "label": "t:sections.product-before-after.settings.corner_radius.label", "default": 8 },
    { "type": "color", "id": "divider_color", "label": "t:sections.product-before-after.settings.divider_color.label", "default": "#ffffff" },
    { "type": "color", "id": "label_bg", "label": "t:sections.product-before-after.settings.label_bg.label", "default": "#000000" },
    { "type": "color", "id": "label_text", "label": "t:sections.product-before-after.settings.label_text.label", "default": "#ffffff" },
    {
      "type": "header",
      "content": "t:sections.product-before-after.settings.padding.content"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.product-before-after.settings.padding_top.label", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.product-before-after.settings.padding_bottom.label", "default": 40 }
  ],
  "presets": [
    { "name": "t:sections.product-before-after.presets.name" }
  ]
}
{% endschema %}
