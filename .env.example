# Shopify store credentials (required for /foundry:plan and later stages)
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local theme preview endpoint (used by playwright.config.ts and QA gate)
FOUNDRY_PREVIEW_URL=http://127.0.0.1:9292

# Test customer used by Playwright flows that require a logged-in session
FOUNDRY_TEST_CUSTOMER_EMAIL=test-customer@example.com
FOUNDRY_TEST_CUSTOMER_PASSWORD=changeme

# Teamwork ticket sync (optional — no-ops cleanly if unset)
TEAMWORK_DOMAIN=yourcompany.teamwork.com
TEAMWORK_API_TOKEN=twp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FOUNDRY_TEAMWORK_TASK_ID=

# Audit log destination override (optional — defaults to Makro-Agency/foundry-logs)
FOUNDRY_AUDIT_REPO=
